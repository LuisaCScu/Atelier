# Local demo looks while waiting for Style Site (default is ingest / pending).
# STYLIST_MODE=local

# Flow-owned handoff webhook — Request 4 looks POSTs { requestId, host }.
# Do not invent a URL on lasting; Flow provides it.
# STYLIST_HANDOFF_WEBHOOK_URL=
# FLOW_HANDOFF_WEBHOOK_URL=

# Optional shared secret for bot routes.
# STYLIST_INGEST_KEY=

# Required on Vercel so POST /api/stylist/looks survives other instances + redeploys.
# Create a free Redis at https://console.upstash.com and paste REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily generate caps. Fitting-board COGS still uses the user/global buckets when fittings are on.
# Free Style generate is 1/UTC day (`FREE_DAILY_GENERATE_LIMIT` in src/lib/freemium.ts).
# STYLIST_GLOBAL_DAILY_LIMIT=20
# STYLIST_USER_DAILY_LIMIT=5
# STYLIST_USER_GENERATE_LIMIT=5
# Set to 0 to stub off 1 generate/day, 10 closet, 10 Lookbook (dev only).
# ATELIER_ENFORCE_FREEMIUM_CAPS=1
