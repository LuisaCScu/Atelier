# Private server credentials: copy to .env.local; never commit actual keys.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# Hosted Production unlock for closet + color-analysis photo APIs (1/true/yes). Loopback always allowed.
ATELIER_ALLOW_HOSTED_PHOTO_APIS=
# GET /api/closet reports openai/<this> when AI_GATEWAY_API_KEY is set (Gateway default gpt-image-1).
CLOSET_GATEWAY_IMAGE_MODEL=gpt-image-1
# GET /api/closet reports this when Gateway is absent (direct OpenAI fallback).
CLOSET_IMAGE_MODEL=gpt-image-2.5-sunburst
CLOSET_VISION_MODEL=gpt-4.1-mini
